# ==============================================================================
# MarketMind Backend Config Template (Copy to .env)
# ==============================================================================

# Core environment status (development | production)
ENVIRONMENT=development

# Secret key used for signing JWT authentication tokens
SECRET_KEY=super_secret_marketmind_development_key_change_me

# PostgreSQL database connection URL (Asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketmind

# Redis cache and Celery broker url
REDIS_URL=redis://localhost:6379/0

# LLM Providers API Keys (Insert active keys to enable AI content generation)
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
CLAUDE_API_KEY=your_claude_key_here

# GitHub repository context details for star validation checks
GITHUB_REPO=owner/repo
