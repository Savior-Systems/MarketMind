# ==============================================================================
# MarketMind Core Environment Variables (Copy to .env)
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/marketmind
REDIS_URL=redis://localhost:6379/0

# LLM API Authentication Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# ==============================================================================
# AI Coding Agents & Tooling Configurations
# ==============================================================================

# 1. Multimodel Dev OS Configuration
MMDOS_ENV=development
MMDOS_API_KEY=your_mmdos_api_key_here

# 2. Caveman Token Compression Agent Config
# Enables token saving mode (ultra-compressed communication)
CAVEMAN_ENABLED=true
CAVEMAN_COMPRESSION_MODE=ultra-compressed  # Options: standard, compressed, ultra-compressed
CAVEMAN_API_KEY=your_caveman_key_here      # Optional if using custom LLM endpoint

# 3. Superpower Agentic Workflows Config
# Set key to authenticate superpower subagent server
SUPERPOWER_SECRET_KEY=your_superpower_secret_key_here
SUPERPOWER_MAX_SUBAGENTS=5
SUPERPOWER_TDD_STRICTNESS=high             # Options: low, medium, high
SUPERPOWER_API_KEY=your_superpower_llm_key  # API key override for superpower agents
